# ─── CampusConnect Environment Variables Template ────────────────────────
# Copy this file to .env or configure these in your Vercel Project Settings

NODE_ENV=development
PORT=5050

# ─── Database ──────────────────────────────────────────────────────────
# For Vercel, use MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# ─── Auth (Secrets MUST be at least 32 characters in production) ────────
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_secure_refresh_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── URLs & CORS ───────────────────────────────────────────────────────
# When deployed on Vercel, these auto-resolve to your Vercel URL
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5050
COOKIE_SECURE=false
EXTRA_CLIENT_URLS=

# ─── Storage (Cloudinary required for serverless deployments) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusconnect
ALLOW_LOCAL_STORAGE=false
MAX_UPLOAD_MB=25

# ─── Email Delivery ────────────────────────────────────────────────────
# In production, configure a real email provider (resend, smtp, sendgrid, ses):
EMAIL_PROVIDER=console
EMAIL_FROM=CampusConnect <no-reply@campusconnect.local>
EMAIL_FROM_NAME=CampusConnect
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_VERIFICATION_DEV_BYPASS=true

