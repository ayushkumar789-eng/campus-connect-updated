{
  "name": "campusconnect-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CampusConnect REST API — student social + academic community platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --watch-path=src src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "db:indexes": "node scripts/ensure-indexes.js",
    "db:migrate:notifications": "node scripts/migrate-notification-entity.js",
    "test:api": "node scripts/smoke.js",
    "test:notifications": "node scripts/smoke-notifications.js",
    "test": "node scripts/smoke.js && node scripts/smoke-notifications.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1143.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  }
}
