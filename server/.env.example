# ─── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050

# ─── Database ──────────────────────────────────────────────────────────
# Local: mongodb://127.0.0.1:27017/campusconnect
# Vercel / Production: MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect

# ─── Auth ──────────────────────────────────────────────────────────────
# Generate strong 64-char secrets for production with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_a_different_secure_refresh_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Client / CORS ─────────────────────────────────────────────────────
# For Vercel deployments, set this to your Vercel URL (e.g. https://my-app.vercel.app)
# If omitted on Vercel, it defaults automatically to your Vercel deployment URL.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5050

# Set to "true" in production (automatically true on Vercel)
COOKIE_SECURE=false

# Extra allowed CORS origins (comma-separated, e.g. for staging or preview URLs)
EXTRA_CLIENT_URLS=

# ─── Storage (Media / Uploads) ──────────────────────────────────────────
# Required for production (Cloudinary is recommended for serverless / Vercel):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=campusconnect

# Set to true only if running on a persistent disk container
ALLOW_LOCAL_STORAGE=false
MAX_UPLOAD_MB=25

# ─── Email ─────────────────────────────────────────────────────────────
# In development: "console" prints verification links to the server terminal.
# In production: Use "resend", "smtp", "sendgrid", or "ses".
EMAIL_PROVIDER=console
EMAIL_FROM=CampusConnect <no-reply@campusconnect.local>
EMAIL_FROM_NAME=CampusConnect

# SMTP credentials (if using EMAIL_PROVIDER=smtp):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Resend API key (if using EMAIL_PROVIDER=resend):
RESEND_API_KEY=

# Sendgrid API key (if using EMAIL_PROVIDER=sendgrid):
SENDGRID_API_KEY=

# AWS SES (if using EMAIL_PROVIDER=ses):
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# In development, returns token in API response. Strictly refused in production.
EMAIL_VERIFICATION_DEV_BYPASS=true

